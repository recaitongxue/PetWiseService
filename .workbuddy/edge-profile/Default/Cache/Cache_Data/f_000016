function generate() {
  const pet = pets.find((p) => p.id === aiPetId.value) || pets[0]
  aiPhase.value = 'thinking'
  let i = 0
  aiStep.value = AI_STEPS[0]
  const timer = setInterval(() => {
    i += 1
    if (i < AI_STEPS.length) {
      aiStep.value = AI_STEPS[i]
    } else {
      clearInterval(timer)
      const existing = new Set(
