  let n = 0
  plan.value.forEach((p, i) => {
    if (!picked.value[i]) return
    addScheduleItem({ ...p, petId: pet.id })
    n += 1
  })
  custom.value = customScheduleItems()
  aiOpen.value = false
  showToast(`已为「${pet.name}」添加 ${n} 条日程`, { type: 'success' })
