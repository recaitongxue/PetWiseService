function fmtDate(iso, diff) {
  const [, m, d] = iso.split('-')
  const label = `${Number(m)}.${d}`
  if (diff === 0) return `今天 ${label}`
  if (diff === 1) return `明天 ${label}`
  if (diff === 2) return `后天 ${label}`
  if (diff < 0) return `${label}（${Math.abs(diff)} 天前）`
  if (diff <= 7) return `${label}（${diff} 天后）`
  return label
}

