    .map((x) => {
      const diff = daysOf(x.date)
      return {
        ...x,
        overdue: diff < 0,
        days: diff,
        dateText: fmtDate(x.date, diff),
        done: doneIds.value.includes(x.id)
      }
    })
    .sort((a, b) => {
      if (a.done !== b.done) return a.done ? 1 : -1
      return a.date < b.date ? -1 : 1
    })
