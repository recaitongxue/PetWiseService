/* ---------- 钱包 ---------- */

const walletOpen = ref(false)
const walletInfo = ref(wallet())
const rechargeAmounts = [30, 50, 100, 200]

function openWallet() {
  walletInfo.value = wallet()
  walletOpen.value = true
}
function recharge(amt) {
  walletInfo.value = walletTransact(amt, '余额充值')
  showToast(`充值 ¥${amt} 成功`, { type: 'success' })
}
function withdraw() {
  if (walletInfo.value.balance <= 0) {
    showToast('余额不足，先充一笔', { type: 'info' })
    return
  }
  const all = walletInfo.value.balance
  walletInfo.value = walletTransact(-all, '提现到微信')
  showToast(`已提现 ¥${all.toFixed(2)} 到微信`, { type: 'success' })
}

/* ---------- 修改密码 ---------- */

const pwdOpen = ref(false)
const pwdError = ref('')
const pwd = reactive({ old: '', n1: '', n2: '' })

function openPwd() {
  pwd.old = ''
  pwd.n1 = ''
  pwd.n2 = ''
  pwdError.value = ''
  pwdOpen.value = true
}
function submitPwd() {
  pwdError.value = ''
  if (pwd.old.length < 6) {
    pwdError.value = '请输入正确的当前密码（演示环境任意 6 位以上）'
    return
  }
  if (pwd.n1.length < 6) {
    pwdError.value = '新密码至少 6 位'
    return
  }
  if (pwd.n1 !== pwd.n2) {
    pwdError.value = '两次输入的新密码不一致'
    return
  }
  if (pwd.n1 === pwd.old) {
    pwdError.value = '新密码不能与当前密码相同'
    return
  }
  pwdOpen.value = false
  showToast('密码已修改，请牢记新密码', { type: 'success' })
}

/* ---------- 编辑资料 ---------- */

const editOpen = ref(false)
