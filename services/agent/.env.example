# 复制为 .env 后按需修改；变量前缀 PW_AGENT_，见 app/config.py

# ── 应用 ──────────────────────────────────────────────
PW_AGENT_ENV=dev
PW_AGENT_PORT=8082
PW_AGENT_LOG_LEVEL=INFO

# ── 服务间鉴权（必须与 api/vision 一致） ───────────────
PW_AGENT_INTERNAL_TOKEN=please-change-internal-token

# ── 数据库（知识库） ──────────────────────────────────
PW_AGENT_DATABASE_URL=postgresql+psycopg://petwise:petwise@localhost:5432/petwise
PW_AGENT_REDIS_URL=redis://localhost:6379/1

# ── 向量与检索 ────────────────────────────────────────
# 维度必须与所选 embedding 模型一致，改模型要重建知识库
PW_AGENT_EMBEDDING_DIM=768
PW_AGENT_RETRIEVAL_TOP_K=6
PW_AGENT_SIMILARITY_THRESHOLD=0.30

# hash（零依赖，仅跑链路）/ local（需安装 embedding extras）/ openai
PW_AGENT_EMBEDDING_PROVIDER=hash
PW_AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
PW_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
PW_AGENT_EMBEDDING_API_KEY=

# heuristic（零依赖）/ cross-encoder（需模型）
PW_AGENT_RERANK_STRATEGY=heuristic

# ── 大语言模型 ────────────────────────────────────────
# 未填 API_KEY 时自动进入 mock 模式：链路可跑通，结论来自规则基线
PW_AGENT_LLM_PROVIDER=openai
PW_AGENT_LLM_MODEL=gpt-4o-mini
PW_AGENT_LLM_BASE_URL=https://api.openai.com/v1
PW_AGENT_LLM_API_KEY=
PW_AGENT_LLM_TEMPERATURE=0.3

# ── 安全开关 ──────────────────────────────────────────
# 是否允许回答中出现具体处方（默认关闭，答辩演示务必保持 false）
PW_AGENT_PRESCRIPTION_ENABLED=false
