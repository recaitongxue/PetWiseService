# 复制为 .env 后按需修改；所有变量前缀为 PW_，见 app/core/config.py

# ── 应用 ──────────────────────────────────────────────
PW_ENV=dev
PW_DEBUG=true
PW_HOST=0.0.0.0
PW_PORT=8080
PW_LOG_LEVEL=INFO
PW_LOG_JSON=false

# ── 数据库 / 缓存 ─────────────────────────────────────
PW_DATABASE_URL=postgresql+psycopg://petwise:petwise@localhost:5432/petwise
PW_REDIS_URL=redis://localhost:6379/0

# ── 鉴权（生产必须更换） ──────────────────────────────
PW_JWT_SECRET=please-change-this-secret-in-production
PW_ACCESS_TOKEN_TTL=7200
PW_REFRESH_TOKEN_TTL=2592000

# ── 下游 AI 服务 ──────────────────────────────────────
PW_VISION_BASE_URL=http://localhost:8081
PW_AGENT_BASE_URL=http://localhost:8082
PW_INTERNAL_TOKEN=please-change-internal-token
PW_VISION_TIMEOUT=3.0
PW_AGENT_TIMEOUT=30.0
PW_AGENT_STREAM_TIMEOUT=90.0

# ── 对象存储 ──────────────────────────────────────────
PW_STORAGE_ENDPOINT=localhost:9000
PW_STORAGE_ACCESS_KEY=petwise
PW_STORAGE_SECRET_KEY=petwise123
PW_STORAGE_BUCKET=petwise
PW_STORAGE_SECURE=false
PW_STORAGE_PUBLIC_BASE=http://localhost:9000/petwise

# ── AI 配额 ───────────────────────────────────────────
PW_AI_DAILY_TRIAGE_QUOTA=5

# ── CORS ──────────────────────────────────────────────
PW_CORS_ORIGINS=*
