# 复制为 .env 后按需修改；变量前缀 PW_VISION_，见 app/config.py

PW_VISION_ENV=dev
PW_VISION_PORT=8081
PW_VISION_LOG_LEVEL=INFO

# 必须与 api / agent 服务一致
PW_VISION_INTERNAL_TOKEN=please-change-internal-token

# 权重目录。容器内通常挂载 ../../cv/artifacts
PW_VISION_ARTIFACTS_DIR=./artifacts

# 推理参数
PW_VISION_IMAGE_SIZE=224
PW_VISION_TOP_K=3
PW_VISION_MAX_IMAGE_MB=10

# 置信度分级阈值
PW_VISION_CONF_HIGH=0.85
PW_VISION_CONF_LOW=0.45

# auto | cpu | cuda
PW_VISION_PROVIDERS=auto
